PORT=5000
MONGODB_URI=mongodb://<db_user>:<url_encoded_password>@<atlas-host-1>:27017,<atlas-host-2>:27017,<atlas-host-3>:27017/?tls=true&replicaSet=<replica-set-name>&authSource=admin&appName=Cluster0
JWT_SECRET=your_jwt_secret_here
PAYMENT_SECRET_KEY=your_payment_secret_key
PAYMENT_PUBLIC_KEY=your_payment_public_key
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
APP_TIME_ZONE=Africa/Lagos
